    "@flowgram.ai/panel-manager-plugin": "1.0.12",
    "@flowgram.ai/runtime-interface": "1.0.12",
    "@flowgram.ai/runtime-js": "1.0.12",
    "@hono/node-server": "^2.0.10",
    "better-sqlite3": "^11.0.0",
    "classnames": "^2.5.1",
    "hono": "^4.12.31",
