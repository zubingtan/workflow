{
  "name": "oncall-workflow-platform",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "next build --experimental-build-mode compile && tsc --noEmit && next build --experimental-build-mode generate",
    "doctor": "node scripts/doctor.mjs",
    "setup": "pnpm install --frozen-lockfile && docker compose --env-file .env.example pull postgres migrate && docker compose --env-file .env.example build app",
    "dev": "node scripts/dev.mjs",
    "dev:build": "node scripts/dev-build.mjs",
    "dev:real": "node scripts/dev-real.mjs",
    "down": "docker compose --env-file .env.example down --remove-orphans",
    "logs": "docker compose --env-file .env.example logs --follow app worker fake-provider postgres",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "worker": "node scripts/worker.mjs",
    "fake-provider": "node scripts/fake-provider.mjs",
    "test": "pnpm test:unit",
    "test:unit": "pnpm test:definition",
    "test:definition": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list"
  },
  "dependencies": {
    "@flowgram.ai/free-layout-editor": "1.0.12",
    "@mariozechner/pi-agent-core": "0.73.1",
    "@mariozechner/pi-ai": "0.73.1",
    "next": "16.2.10",
    "postgres": "3.4.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "typebox": "1.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
