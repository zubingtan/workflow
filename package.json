    "@flowgram.ai/free-layout-editor": "1.0.12",
    "@flowgram.ai/free-lines-plugin": "1.0.12",
    "@flowgram.ai/free-node-panel-plugin": "1.0.12",
    "@flowgram.ai/free-snap-plugin": "1.0.12",
    "@flowgram.ai/free-stack-plugin": "1.0.12",
