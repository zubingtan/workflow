    "nanoid": "^5.0.9",
    "react": "^18",
    "react-dom": "^18",
    "styled-components": "^5"
  },
  "devDependencies": {
    "@flowgram.ai/eslint-config": "1.0.12",
    "@flowgram.ai/ts-config": "1.0.12",
    "@rsbuild/core": "^1.2.16",
    "@rsbuild/plugin-less": "^1.1.1",
    "@rsbuild/plugin-react": "^1.1.1",
    "@types/lodash-es": "^4.17.12",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^18",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/styled-components": "^5",
    "concurrently": "^10.0.3",
    "cross-env": "~7.0.3",
    "eslint": "^9.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.0",
    "prettier": "^2.8.8",
    "typescript": "^5.8.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "exit 0",
    "build:fast": "exit 0",
    "build:watch": "exit 0",
    "build:prod": "cross-env MODE=app NODE_ENV=production rsbuild build",
    "build:analyze": "BUNDLE_ANALYZE=true rsbuild build",
    "clean": "rimraf dist",
    "dev": "cross-env MODE=app NODE_ENV=development rsbuild dev --open",
    "lint": "eslint ./src --cache",
    "lint:fix": "eslint ./src --fix",
    "ts-check": "tsc --noEmit",
    "start": "cross-env NODE_ENV=development rsbuild dev --open",
    "test": "exit",
    "test:cov": "exit",
    "watch": "exit 0",
    "server": "node --env-file=.env server/index.mjs",
    "fake-provider": "node --env-file=.env scripts/fake-provider.mjs",
    "dev:all": "concurrently -n fake,server,web -c green,blue,magenta \"pnpm fake-provider\" \"pnpm server\" \"pnpm dev\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,less,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,less,css,md}\"",
    "prepare": "husky"
  },
  "packageManager": "pnpm@11.13.0",
  "lint-staged": {
    "src/**/*.{ts,tsx,js,jsx}": "eslint --fix",
    "*.{ts,tsx,js,jsx,json,less,css,md,yml,yaml}": "prettier --write"
  }
}
