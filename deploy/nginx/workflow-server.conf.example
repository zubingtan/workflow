# workflow nginx server block — copy-paste starting point for a fresh install.
#
# Drop this into /etc/nginx/conf.d/ (Debian/Ubuntu layout) or include the
# location fragment manually into an existing server block of yours.
# Replace {{HOST}} with your domain. install.sh does all of this for you.
#
# Base path: the app is built with BASE_PATH=/workflow and nginx keeps the
# prefix (no URI stripping in proxy_pass) — see deploy/nginx/workflow-location.conf.

server {
    listen 80;
    server_name {{HOST}};

    # /workflow -> /workflow/ so the SPA loads without a trailing slash.
    location = /workflow {
        return 301 /workflow/;
    }

    # The whole app under one prefix: dashboard + API + SSE.
    location /workflow/ {
        proxy_pass http://127.0.0.1:{{PORT}};
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # SSE (/api/runs/events): no buffering, HTTP/1.1, long read timeout.
        proxy_set_header Connection '';
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 86400s;
        gzip off;
    }
}
