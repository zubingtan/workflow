# workflow systemd unit — used by install.sh when supervisord is unavailable.
# Template with {{PLACEHOLDERS}} — rendered by install.sh:
#   {{WF_DIR}} {{NODE_BIN}} {{PORT}} {{BASE_PATH}} {{DATA_DIR}} {{FAKE_PROVIDER_PORT}}
#
# Install:
#   sudo cp workflow.service /etc/systemd/system/ && sudo systemctl daemon-reload \
#     && sudo systemctl enable --now workflow

[Unit]
Description=FlowGram workflow (Hono + SPA)
After=network.target

[Service]
Type=simple
WorkingDirectory={{WF_DIR}}
ExecStart={{NODE_BIN}} server/index.mjs
Environment=NODE_ENV=production
Environment=PORT={{PORT}}
Environment=BASE_PATH={{BASE_PATH}}
Environment=WORKFLOW_DATA_DIR={{DATA_DIR}}
Restart=always
RestartSec=3
# supervisord-style log targets (no journald dependency)
StandardOutput=append:{{DATA_DIR}}/logs/workflow.out.log
StandardError=append:{{DATA_DIR}}/logs/workflow.err.log

[Install]
WantedBy=multi-user.target
