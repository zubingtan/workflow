{
  "apiVersion": "oncall.workflow/v1alpha1",
  "kind": "Workflow",
  "metadata": { "name": "m0-smoke" },
  "spec": {
    "nodes": [
      { "id": "prompt", "type": "input.prompt", "config": {} },
      {
        "id": "analyze",
        "type": "process.agent",
        "config": {
          "agentVersionRef": "seed-agent-v1",
          "providerBindingRef": "fake-default"
        }
      },
      { "id": "result", "type": "output.markdown", "config": {} }
    ],
    "edges": [
      {
        "from": "prompt",
        "to": "analyze",
        "mapping": [{ "from": "prompt", "to": "prompt" }]
      },
      {
        "from": "analyze",
        "to": "result",
        "mapping": [{ "from": "markdown", "to": "markdown" }]
      }
    ]
  }
}
