POSTGRES_DB=workflow
POSTGRES_USER=workflow
POSTGRES_PASSWORD=workflow
DATABASE_URL=postgres://workflow:workflow@postgres:5432/workflow
PROVIDER_BINDINGS_FILE=config/provider-bindings.example.json
# Worker-only provider credentials are loaded from this optional local file.
WORKFLOW_ENV_FILE=.env
FAKE_PROVIDER_API_KEY=fake-provider-local
APP_PORT=3000
WORKER_PROVIDER_TIMEOUT_MS=30000
WORKER_LEASE_MS=300000
WORKER_FAULT_HOOK=
