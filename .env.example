# .env.example — dev-mode defaults. For prod, copy to .env.production
# and override PORT=4000 (or use Docker env vars).

FAKE_PROVIDER_API_KEY=fake-provider-local
# PORT=4001
FAKE_PROVIDER_PORT=4010
# WORKFLOW_DATA_DIR=
# COPILOT_PROVIDER_BASE_URL=https://your-provider/api
# COPILOT_PROVIDER_API_KEY=sk-...

# Feishu event ingress. Defaults to long_connection. Feishu app credentials are
# configured in Feishu Trigger nodes in the workflow editor; the server starts
# one long-connection client per unique enabled trigger app.
# FEISHU_EVENT_MODE=long_connection

# Webhook callback mode only.
# FEISHU_EVENT_VERIFICATION_TOKEN=
# FEISHU_EVENT_ENCRYPT_KEY=
